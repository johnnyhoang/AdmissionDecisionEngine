# Root / Workspace Environment Reference

# Frontend (apps/web/.env.local)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:5003

# Backend (apps/api/.env)
PORT=5003
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
CORS_ALLOWED_ORIGINS=http://localhost:5176,http://localhost:5173,http://localhost:3000
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=5
