# ==========================================
# ADMISSION DECISION ENGINE - ENVIRONMENT VARIABLES REFERENCE
# ==========================================

# ------------------------------------------
# Frontend Environment Variables (apps/frontend)
# ------------------------------------------
# Supabase URL for Client Authentication & API calls
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Key (Public API Key)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend API Endpoint URL for Frontend Service
VITE_API_URL=http://localhost:5003

# ------------------------------------------
# Backend Environment Variables (apps/backend)
# ------------------------------------------
# Server Port for Local Development
PORT=5003

# Supabase Project URL for JWKS JWT Verification
SUPABASE_URL=https://your-project-ref.supabase.co

# JWT Secret Fallback Key
JWT_SECRET=super_secret_jwt_key_hieu_hoa

# PostgreSQL Database Connection String (Supabase Pooler / Direct connection)
DATABASE_URL=postgresql://postgres.xxx:your_db_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Allowed Origins for CORS Cross-Origin Requests
CORS_ALLOWED_ORIGINS=http://localhost:5177,http://localhost:5176,http://localhost:5173,http://localhost:3000

# Database SSL Certificate Verification (false for cloud pooler with self-signed certs)
DB_SSL_REJECT_UNAUTHORIZED=false

# Database Connection Pool Limits
DB_POOL_MAX=5

# AI Keys
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
JWT_EXPIRES_IN=1h

