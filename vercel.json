{
  "version": 2,
  "builds": [
    {
      "src": "apps/backend/api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "apps/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "apps/backend/api/index.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "apps/backend/api/index.ts"
    },
    {
      "src": "/(.*\\.[a-zA-Z0-9]+)$",
      "dest": "apps/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "apps/frontend/index.html"
    }
  ]
}
